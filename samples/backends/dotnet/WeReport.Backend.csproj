<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>WeReport.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Npgsql" Version="9.*" />
    <!-- SqlClient pulls in a version with known advisories (GHSA-846f-f764-76mx); pin the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared fictional sample dataset, used when no connections are configured. -->
    <None Include="../../data/seed.sql" Link="seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

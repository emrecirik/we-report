{
  "version": 1,
  "name": "Termal fiş",
  "page": { "paper": "Thermal80", "orientation": "portrait", "margins": { "top": 3, "right": 3, "bottom": 6, "left": 3 }, "displayUnit": "mm" },
  "styles": {
    "default": { "fontFamily": "Noto Sans", "fontSize": 8, "color": "#000000", "padding": 0.3 },
    "center": { "textAlign": "center" },
    "store": { "fontSize": 12, "bold": true, "textAlign": "center" },
    "right": { "textAlign": "right" },
    "total": { "fontSize": 11, "bold": true, "textAlign": "right" }
  },
  "dataSources": [{ "id": "receipt", "name": "Fiş", "kind": "json", "data": null }],
  "dataMember": { "dataSourceId": "receipt", "path": "items" },
  "bands": [
    {
      "id": "reportHeader", "kind": "reportHeader", "height": 33,
      "controls": [
        { "id": "store", "type": "text", "x": 0, "y": 0, "width": 74, "height": 7, "style": "store", "text": { "expression": "Upper([^.store.name])" } },
        { "id": "addr", "type": "text", "x": 0, "y": 7, "width": 74, "height": 8, "style": "center", "text": { "expression": "[^.store.address] + '\n' + [^.store.city] + ' · VKN ' + [^.store.taxNo]" }, "canGrow": true },
        { "id": "rule1", "type": "line", "x": 0, "y": 16, "width": 74, "height": 1, "direction": "horizontal", "lineWidth": 0.2, "color": "#000000" },
        { "id": "no", "type": "text", "x": 0, "y": 18, "width": 37, "height": 4.5, "text": { "expression": "'Fiş: ' + [^.receiptNo]" } },
        { "id": "when", "type": "text", "x": 37, "y": 18, "width": 37, "height": 4.5, "style": "right", "text": { "expression": "[^.date]" }, "format": "dd.MM.yyyy HH:mm" },
        { "id": "cashier", "type": "text", "x": 0, "y": 22.5, "width": 74, "height": 4.5, "text": { "expression": "[^.cashier]" } },
        { "id": "rule2", "type": "line", "x": 0, "y": 28, "width": 74, "height": 1, "direction": "horizontal", "lineWidth": 0.2, "color": "#000000" }
      ]
    },
    {
      "id": "detail", "kind": "detail", "height": 8.5,
      "controls": [
        { "id": "item", "type": "text", "x": 0, "y": 0, "width": 74, "height": 4.2, "text": { "expression": "[name]" }, "canGrow": true },
        { "id": "qty", "type": "text", "x": 0, "y": 4.2, "width": 40, "height": 4.2, "text": { "expression": "Format([qty], 'n0') + ' x ' + Format([price], 'n2')" } },
        { "id": "line", "type": "text", "x": 40, "y": 4.2, "width": 34, "height": 4.2, "style": "right", "text": { "expression": "[qty] * [price]" }, "format": "n2" }
      ]
    },
    {
      "id": "reportFooter", "kind": "reportFooter", "height": 52,
      "controls": [
        { "id": "rule3", "type": "line", "x": 0, "y": 1, "width": 74, "height": 1, "direction": "horizontal", "lineWidth": 0.2, "color": "#000000" },
        { "id": "totalLabel", "type": "text", "x": 0, "y": 3, "width": 30, "height": 6, "style": "total", "styleOverrides": { "textAlign": "left" }, "text": "TOPLAM" },
        { "id": "total", "type": "text", "x": 30, "y": 3, "width": 44, "height": 6, "style": "total", "text": { "expression": "Sum([qty] * [price])" }, "format": "c2" },
        { "id": "vat", "type": "text", "x": 0, "y": 9, "width": 74, "height": 4.5, "style": "right", "text": { "expression": "'KDV dahil (%10): ' + Format(Sum([qty] * [price]) / 11, 'n2')" } },
        { "id": "pay", "type": "text", "x": 0, "y": 13.5, "width": 74, "height": 4.5, "style": "right", "text": { "expression": "[^.payment]" } },
        { "id": "qr", "type": "barcode", "x": 22, "y": 20, "width": 30, "height": 22, "symbology": "qrcode", "value": { "expression": "'https://example.com/fis/' + [^.receiptNo]" }, "showText": false },
        { "id": "thanks", "type": "text", "x": 0, "y": 43, "width": 74, "height": 5, "style": "center", "text": "Bizi tercih ettiğiniz için teşekkürler" },
        { "id": "note", "type": "text", "x": 0, "y": 47.5, "width": 74, "height": 4, "style": "center", "styleOverrides": { "fontSize": 6 }, "text": "Örnek fiştir, mali değeri yoktur." }
      ]
    }
  ]
}

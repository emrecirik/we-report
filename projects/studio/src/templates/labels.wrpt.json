{
  "version": 1,
  "name": "Raf etiketi",
  "locale": "tr-TR",
  "currency": "TRY",
  "page": {
    "paper": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 15.15,
      "left": 7.21,
      "right": 7.21,
      "bottom": 15.15
    },
    "displayUnit": "mm"
  },
  "styles": {
    "default": {
      "fontFamily": "Noto Sans",
      "fontSize": 8,
      "color": "#1f2328",
      "padding": 0.5
    },
    "name": {
      "fontSize": 9,
      "bold": true
    },
    "price": {
      "fontSize": 16,
      "bold": true,
      "color": "#1d4ed8",
      "textAlign": "right"
    },
    "unit": {
      "fontSize": 7,
      "color": "#6b7280"
    }
  },
  "dataSources": [
    {
      "id": "products",
      "name": "Products",
      "kind": "json",
      "data": null
    }
  ],
  "dataMember": {
    "dataSourceId": "products",
    "path": "lines"
  },
  "bands": [
    {
      "id": "detail",
      "kind": "detail",
      "height": 38.1,
      "columns": {
        "count": 3,
        "gap": 2.54
      },
      "controls": [
        {
          "id": "frame",
          "type": "shape",
          "shape": "roundedRectangle",
          "cornerRadius": 2,
          "x": 1,
          "y": 1,
          "width": 61.5,
          "height": 36.1,
          "styleOverrides": {
            "border": {
              "width": 0.25,
              "color": "#cbd5e1",
              "sides": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
              }
            }
          }
        },
        {
          "id": "product",
          "type": "text",
          "style": "name",
          "x": 3,
          "y": 3,
          "width": 57.5,
          "height": 9,
          "text": {
            "expression": "[product]"
          }
        },
        {
          "id": "vat",
          "type": "text",
          "style": "unit",
          "x": 3,
          "y": 13.5,
          "width": 24,
          "height": 5,
          "text": {
            "expression": "'KDV %' + [vat] + ' dahil'"
          }
        },
        {
          "id": "price",
          "type": "text",
          "style": "price",
          "x": 24,
          "y": 11.5,
          "width": 36.5,
          "height": 8,
          "text": {
            "expression": "[price] * (1 + [vat] / 100)"
          },
          "format": "c2"
        },
        {
          "id": "barcode",
          "type": "barcode",
          "symbology": "code128",
          "x": 3,
          "y": 21,
          "width": 57.5,
          "height": 14,
          "value": {
            "expression": "[code]"
          },
          "showText": true
        }
      ]
    }
  ]
}

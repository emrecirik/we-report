    },
    {
      "id": "month",
      "kind": "groupHeader",
      "height": 9,
      "groupBy": {
        "expression": "Format([due], 'yyyy-MM')"
      },
      "keepWithFirstRow": true,
      "bookmark": {
        "expression": "Format([due], 'MMMM yyyy')"
      },
      "controls": [
        {
          "id": "gname",
          "type": "text",
          "x": 0,
          "y": 1,
          "width": 160,
          "height": 7,
          "text": {
            "expression": "Format([due], 'MMMM yyyy')"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 10,
            "color": "#0f766e",
            "verticalAlign": "middle"
          }
        },
        {
          "id": "gcount",
          "type": "text",
          "x": 160,
          "y": 1,
          "width": 107,
          "height": 7,
          "text": {
            "expression": "Count() + ' evrak'"
          },
          "style": "muted",
          "styleOverrides": {
            "textAlign": "right",
            "verticalAlign": "middle"
          }
        }
      ]
    },
    {
      "id": "detail",
      "kind": "detail",
      "height": 6.5,
      "alternateBackgroundColor": "#f0fdfa",
      "controls": [
        {
          "id": "td0",
          "type": "text",
          "x": 0,
          "y": 0,
          "width": 22,
          "height": 6.5,
          "text": {
            "expression": "[no]"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "left"
          }
        },
        {
          "id": "td1",
          "type": "text",
          "x": 22,
          "y": 0,
          "width": 16,
          "height": 6.5,
          "text": {
            "expression": "[kind]"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "left"
          }
        },
        {
          "id": "td2",
          "type": "text",
          "x": 38,
          "y": 0,
          "width": 62,
          "height": 6.5,
          "text": {
            "expression": "[bank]"

          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "left"
          }
        },
        {
          "id": "td3",
          "type": "text",
          "x": 100,
          "y": 0,
          "width": 62,
          "height": 6.5,
          "text": {
            "expression": "[drawer]"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "left"
          }
        },
        {
          "id": "td4",
          "type": "text",
          "x": 162,
          "y": 0,
          "width": 24,
          "height": 6.5,
          "text": {
            "expression": "[due]"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "right"
          },
          "format": "dd.MM.yyyy"
        },
        {
          "id": "td5",
          "type": "text",
          "x": 186,
          "y": 0,
          "width": 22,
          "height": 6.5,
          "text": {
            "expression": "DateDiff('day', [^.date], [due])"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "right"
          },
          "format": "n0",
          "formatting": [
            {
              "when": "DateDiff('day', [^.date], [due]) <= 7",
              "style": {
                "color": "#b91c1c",
                "bold": true
              }
            }
          ]
        },
        {
          "id": "td6",
          "type": "text",
          "x": 208,
          "y": 0,
          "width": 30,
          "height": 6.5,
          "text": {
            "expression": "[amount]"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "right"
          },
          "format": "n2"
        },
        {
          "id": "td7",
          "type": "text",
          "x": 238,
          "y": 0,
          "width": 29,
          "height": 6.5,
          "text": {
            "expression": "RunningSum([amount])"
          },
          "styleOverrides": {
            "fontSize": 8.5,
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "right"
          },
          "format": "n2"
        }
      ]

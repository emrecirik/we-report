        },
        {
          "id": "th6",
          "type": "text",
          "x": 208,
          "y": 18,
          "width": 30,
          "height": 8,
          "text": "Tutar",
          "styleOverrides": {
            "fontSize": 8,
            "bold": true,
            "color": "#ffffff",
            "backgroundColor": "#0f766e",
            "verticalAlign": "middle",
            "padding": 1.2,
            "textAlign": "right"
          }
        },
        {
          "id": "th7",
          "type": "text",
          "x": 238,

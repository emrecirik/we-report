{
  "version": 1,
  "name": "Çek / senet bordrosu",
  "page": {
    "paper": "A4",
    "orientation": "landscape",
    "margins": {
      "top": 12,
      "right": 15,
      "bottom": 10,
      "left": 15
    },
    "displayUnit": "mm"
  },
  "styles": {
    "default": {
      "fontFamily": "Noto Sans",
      "fontSize": 9,
      "color": "#1f2328",
      "padding": 0.8
    },
    "brand": {
      "fontSize": 13,
      "bold": true,
      "color": "#0f766e"
    },
    "title": {
      "fontSize": 16,
      "bold": true,
      "color": "#0f766e",
      "textAlign": "right"
    },
    "muted": {
      "fontSize": 8,
      "color": "#6b7280"
    },
    "label": {
      "fontSize": 8,
      "color": "#6b7280",
      "bold": true
    },
    "big": {
      "fontSize": 18,
      "bold": true,
      "color": "#0f766e"
    },
    "sign": {
      "fontSize": 8,
      "color": "#6b7280",
      "textAlign": "center",
      "border": {
        "width": 0.3,
        "color": "#1f2328",
        "sides": {
          "top": true,
          "right": false,
          "bottom": false,
          "left": false
        }
      }
    },
    "th": {
      "fontSize": 8,
      "bold": true,
      "color": "#0f766e",
      "verticalAlign": "middle",
      "padding": 1.2,
      "border": {
        "width": 0.4,
        "color": "#0f766e",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    },
    "cell": {
      "verticalAlign": "middle",
      "padding": 1.2,
      "border": {
        "width": 0.1,
        "color": "#d1d5db",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    },
    "num": {
      "verticalAlign": "middle",
      "padding": 1.2,
      "textAlign": "right",
      "border": {
        "width": 0.1,
        "color": "#d1d5db",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    }
  },
  "dataSources": [
    {
      "id": "cheques",
      "name": "Evraklar",
      "kind": "json",
      "data": null
    }
  ],
  "dataMember": {
    "dataSourceId": "cheques",
    "path": "items"
  },
  "locale": "tr-TR",
  "currency": "TRY",
  "bands": [
    {
      "id": "pageHeader",
      "kind": "pageHeader",
      "height": 27,
      "controls": [
        {
          "id": "company",
          "type": "text",
          "x": 0,
          "y": 0,
          "width": 160,
          "height": 8,
          "text": {
            "expression": "[^.company]"
          },
          "style": "brand"
        },
        {
          "id": "title",
          "type": "text",
          "x": 160,
          "y": 0,
          "width": 107,
          "height": 9,
          "text": "ÇEK / SENET BORDROSU",
          "style": "title"
        },
        {
          "id": "date",
          "type": "text",
          "x": 160,
          "y": 9,
          "width": 107,
          "height": 5,
          "text": {
            "expression": "'Düzenleme: ' + Format([^.date], 'dd.MM.yyyy')"
          },
          "style": "muted",
          "styleOverrides": {
            "textAlign": "right"

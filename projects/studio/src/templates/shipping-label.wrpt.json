{
  "version": 1,
  "name": "Kargo etiketi",
  "page": {
    "paper": "custom",
    "width": 100,
    "height": 150,
    "orientation": "portrait",
    "margins": {
      "top": 4,
      "right": 4,
      "bottom": 4,
      "left": 4
    },
    "displayUnit": "mm"
  },
  "styles": {
    "default": {
      "fontFamily": "Noto Sans",
      "fontSize": 9,
      "color": "#1f2328",
      "padding": 0.8
    },
    "brand": {
      "fontSize": 13,
      "bold": true,
      "color": "#0f766e"
    },
    "title": {
      "fontSize": 16,
      "bold": true,
      "color": "#0f766e",
      "textAlign": "right"
    },
    "muted": {
      "fontSize": 8,
      "color": "#6b7280"
    },
    "label": {
      "fontSize": 8,
      "color": "#6b7280",
      "bold": true
    },
    "big": {
      "fontSize": 18,
      "bold": true,
      "color": "#0f766e"
    },
    "sign": {
      "fontSize": 8,
      "color": "#6b7280",
      "textAlign": "center",
      "border": {
        "width": 0.3,
        "color": "#1f2328",
        "sides": {
          "top": true,
          "right": false,
          "bottom": false,
          "left": false
        }
      }
    },
    "th": {
      "fontSize": 8,
      "bold": true,
      "color": "#0f766e",
      "verticalAlign": "middle",
      "padding": 1.2,
      "border": {
        "width": 0.4,
        "color": "#0f766e",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    },
    "cell": {
      "verticalAlign": "middle",
      "padding": 1.2,
      "border": {
        "width": 0.1,
        "color": "#d1d5db",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    },
    "num": {
      "verticalAlign": "middle",
      "padding": 1.2,
      "textAlign": "right",
      "border": {
        "width": 0.1,
        "color": "#d1d5db",
        "sides": {
          "top": false,
          "right": false,
          "bottom": true,
          "left": false
        }
      }
    }
  },
  "dataSources": [
    {
      "id": "shipments",
      "name": "Gönderiler",
      "kind": "json",
      "data": null
    }
  ],
  "dataMember": {
    "dataSourceId": "shipments",
    "path": "shipments"
  },
  "locale": "tr-TR",
  "currency": "TRY",
  "bands": [
    {
      "id": "detail",
      "kind": "detail",
      "height": 138,
      "pageBreakAfter": true,
      "controls": [
        {
          "id": "fromLbl",
          "type": "text",
          "x": 0,
          "y": 0,
          "width": 30,
          "height": 4,
          "text": "GÖNDEREN",
          "style": "label"
        },
        {
          "id": "from",
          "type": "text",
          "x": 0,
          "y": 4,
          "width": 90,
          "height": 5,
          "text": {
            "expression": "[^.sender.name]"
          },
          "styleOverrides": {
            "bold": true
          }
        },
        {
          "id": "fromAddr",
          "type": "text",
          "x": 0,
          "y": 9,
          "width": 90,
          "height": 8,
          "text": {
            "expression": "[^.sender.address] + ', ' + [^.sender.city] + ' · ' + [^.sender.phone]"
          },
          "style": "muted",
          "canGrow": true
        },
        {
          "id": "r1",
          "type": "line",
          "x": 0,
          "y": 18,
          "width": 92,
          "height": 1,
          "direction": "horizontal",
          "lineWidth": 0.4,
          "color": "#1f2328"
        },
        {
          "id": "toLbl",
          "type": "text",
          "x": 0,
          "y": 20,
          "width": 30,
          "height": 4,
          "text": "ALICI",
          "style": "label"
        },
        {
          "id": "to",
          "type": "text",
          "x": 0,
          "y": 24,
          "width": 92,
          "height": 8,
          "text": {
            "expression": "Upper([receiver])"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 15
          }
        },
        {
          "id": "toAddr",
          "type": "text",
          "x": 0,
          "y": 32,
          "width": 92,
          "height": 11,
          "text": {
            "expression": "[address]"
          },
          "styleOverrides": {
            "fontSize": 10
          },
          "canGrow": true
        },
        {
          "id": "toCity",
          "type": "text",
          "x": 0,
          "y": 43,
          "width": 92,
          "height": 7,
          "text": {
            "expression": "Upper([city])"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 12
          }
        },
        {
          "id": "toPhone",
          "type": "text",
          "x": 0,
          "y": 50,
          "width": 92,
          "height": 5,
          "text": {
            "expression": "'Tel: ' + [phone]"
          }
        },
        {
          "id": "r2",
          "type": "line",
          "x": 0,
          "y": 56,
          "width": 92,
          "height": 1,
          "direction": "horizontal",
          "lineWidth": 0.4,
          "color": "#1f2328"
        },
        {
          "id": "branch",
          "type": "text",
          "x": 0,
          "y": 58,
          "width": 45,
          "height": 14,
          "text": {
            "expression": "[branch]"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 20,
            "verticalAlign": "middle",
            "textAlign": "center",
            "border": {
              "width": 0.4,
              "color": "#1f2328",
              "sides": {
                "top": true,
                "right": true,
                "bottom": true,
                "left": true
              }
            }
          }
        },
        {
          "id": "pcsLbl",
          "type": "text",
          "x": 48,
          "y": 58,
          "width": 22,
          "height": 4,
          "text": "PARÇA",
          "style": "label"
        },
        {
          "id": "pcs",
          "type": "text",
          "x": 48,
          "y": 62,
          "width": 22,
          "height": 9,
          "text": {
            "expression": "[pieces] + ' adet'"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 12
          }
        },
        {
          "id": "desiLbl",
          "type": "text",
          "x": 71,
          "y": 58,
          "width": 21,
          "height": 4,
          "text": "DESİ",
          "style": "label"
        },
        {
          "id": "desi",
          "type": "text",
          "x": 71,
          "y": 62,
          "width": 21,
          "height": 9,
          "text": {
            "expression": "[desi]"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 12
          }
        },
        {
          "id": "pay",
          "type": "text",
          "x": 0,
          "y": 74,
          "width": 92,
          "height": 7,
          "text": {
            "expression": "Upper([payment])"
          },
          "styleOverrides": {
            "bold": true,
            "fontSize": 11,
            "textAlign": "center",
            "color": "#ffffff",
            "backgroundColor": "#1f2328",
            "verticalAlign": "middle"
          }
        },
        {
          "id": "bc",
          "type": "barcode",
          "x": 2,
          "y": 84,
          "width": 88,
          "height": 26,
          "symbology": "code128",
          "value": {
            "expression": "[tracking]"
          },
          "showText": true
        },
        {
          "id": "qr",
          "type": "barcode",
          "x": 0,
          "y": 114,
          "width": 22,
          "height": 22,
          "symbology": "qrcode",
          "value": {
            "expression": "'https://example.com/kargo/' + [tracking]"
          },
          "showText": false
        },
        {
          "id": "orderLbl",
          "type": "text",
          "x": 25,
          "y": 115,
          "width": 30,
          "height": 4,
          "text": "SİPARİŞ",
          "style": "label"
        },
        {
          "id": "order",
          "type": "text",
          "x": 25,
          "y": 119,
          "width": 67,
          "height": 6,
          "text": {
            "expression": "[order]"
          },
          "styleOverrides": {
            "bold": true
          }
        },
        {
          "id": "track",
          "type": "text",
          "x": 25,
          "y": 127,
          "width": 67,
          "height": 5,
          "text": {
            "expression": "'Takip: ' + [tracking]"
          },
          "style": "muted"
        }
      ]
    }
  ]
}

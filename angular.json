{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "we-report-core": {
      "projectType": "library",
      "root": "projects/we-report-core",
      "sourceRoot": "projects/we-report-core/src",
      "prefix": "wr",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/we-report-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/we-report-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/we-report-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/we-report-core/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "assets": [
              {
                "glob": "*.ttf",
                "input": "projects/we-report-core/fonts",
                "output": "/fonts"
              }
            ]
          }
        }
      }
    },
    "we-report": {
      "projectType": "library",
      "root": "projects/we-report",
      "sourceRoot": "projects/we-report/src",
      "prefix": "we-report",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/we-report/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/we-report/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/we-report/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/we-report/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "assets": [
              {
                "glob": "*.ttf",
                "input": "projects/we-report-core/fonts",
                "output": "assets/we-report/fonts"
              }
            ]
          }
        }
      }
    },
    "studio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/studio",
      "sourceRoot": "projects/studio/src",
      "prefix": "studio",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/studio",
            "index": "projects/studio/src/index.html",
            "browser": "projects/studio/src/main.ts",
            "allowedCommonJsDependencies": ["pako"],
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/studio/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/studio/public"
              },
              {
                "glob": "*.ttf",
                "input": "projects/we-report-core/fonts",
                "output": "assets/we-report/fonts"
              }
            ],
            "styles": [
              "projects/studio/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "studio:build:production"
            },
            "development": {
              "buildTarget": "studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/studio/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/studio/public"
              }
            ],
            "styles": [
              "projects/studio/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
